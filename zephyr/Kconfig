config ZEPHYR_DEVFS_DRIVER
    default n
    bool "use devfs driver"

if ZEPHYR_DEVFS_DRIVER

config I2C_DEV_LOG_LEVEL
    int "i2c_dev log level"
    range 0 4
    default 1
    help
        Log level for i2c_dev module

config ZEPHYR_DEVFS_RANDOM_TEST
	default n
	bool "enable /dev/urandom devfs test command"
	help
	  Build the random_fs_test shell command. It exercises multiple opens,
	  fcntl status flags, poll, read sizes, burst reads, and concurrent
	  readers against /dev/urandom.

endif # ZEPHYR_DEVFS_DRIVER
